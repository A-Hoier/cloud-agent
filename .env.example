# Shared by web and worker
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_CLIENT_ID=
GITHUB_REPOSITORIES=your-org/your-repo

# Worker only; place secrets in ACA secrets, not in a committed env file
GITHUB_PAT=
MODEL_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/responses
MODEL_NAME=your-deployment
# Omit for Foundry managed-identity authentication
MODEL_API_KEY=
MODEL_AUTH_MODE=auto
MODEL_REASONING_EFFORT=medium
MODEL_TOKEN_SCOPE=auto
HARNESS_PROVIDER=deepseek

# Web only: preselect direct-to-main for eligible new GitHub/main sessions
DEFAULT_DIRECT_TO_MAIN=false
# Web only: required to stop a running ACA Job execution from the UI
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
WORKER_JOB_NAME=cloud-agent-worker

# Trial only: follow-up turns cannot recover unpushed code
PUSH_ENABLED=true
